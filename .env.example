# Copia este archivo como .env y/o usa estos mismos valores para llenar js/config.js
# Este proyecto es HTML/CSS/JS estático: estas variables no se leen en runtime desde
# process.env (no hay bundler ni servidor Node). Sirven como referencia de qué
# credenciales necesitas para completar js/config.js antes de desplegar a producción.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Cloudinary (Settings > Upload > Upload presets, modo "Unsigned")
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# WhatsApp del negocio en formato internacional, sin signos ni espacios
WHATSAPP_NUMBER=
